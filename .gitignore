__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
output
output/
logs/

# GPQA-Diamond is a gated dataset (Idavidrein/gpqa). Access is conditional on
# never publishing problem text, options, answers, or model responses. Per-problem
# outputs already land under the ignored output/, but block the pattern outright
# so a `git add -f` or a stray path can't leak them. See data/README.md.
*gpqa*.jsonl
*gpqa*.json
**/gpqa_problems*

wandb/
*.pt
*.safetensors
*.bin
.venv/
.venv-vllm/
.venv-hrm/
tmp
.env
.env.*
!.env.example

# experiments — keep configs/scripts, ignore downloaded weights + cloned upstream repos + logs
experiments/**/HRM-Text-1B/
experiments/**/HRM-Text-repo/
experiments/**/*.log
.claude/

# LaTeX build artifacts. docs/paper/build/*.tex is regenerated from the
# markdown by scripts/build_paper.sh; main.pdf is committed so the current
# draft is readable without a TeX install.
docs/paper/build/
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.toc
